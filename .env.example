# Copie para .env e preencha:  cp .env.example .env

# xiaozhi.me/console/agents -> Configurar função -> MCP Endpoint (canto inferior direito)
# Trate como segredo: quem tem esta URL injeta tools no seu agente.
MCP_ENDPOINT=wss://api.xiaozhi.me/mcp/?token=SEU_TOKEN

# feriadosapi.com/dashboard -> token (plano free). FERIADOS_UF = estado padrão (opcional)
FERIADOS_API_KEY=
FERIADOS_UF=

# Tools ativas, separadas por vírgula. Se vazio/ausente, usa enabled_tools do config.yaml
# ENABLED_TOOLS=calculo,feriados,sistema,tempo

# Pasta das tools personalizadas (padrão: ./custom_tools; no container /app/custom_tools)
# CUSTOM_TOOLS_DIR=

# Opcional: carregar segredos via Infisical (`infisical run`). Sem os IDs, vale o .infisical.json
# USE_INFISICAL=false
# INFISICAL_ENV=dev
# INFISICAL_PROJECT_ID=
# INFISICAL_TOKEN=
# INFISICAL_PATH=/
