# Copie para .env e preencha:  cp .env.example .env

# xiaozhi.me/console/agents -> Configurar função -> MCP Endpoint (canto inferior direito)
# Trate como segredo: quem tem esta URL injeta tools no seu agente.
MCP_ENDPOINT=wss://api.xiaozhi.me/mcp/?token=SEU_TOKEN

# feriadosapi.com/dashboard -> token (plano free). FERIADOS_UF = estado padrão (opcional)
FERIADOS_API_KEY=
FERIADOS_UF=

# Cidade padrão da tool clima (Open-Meteo, sem API key). Opcional
CLIMA_CIDADE=

# Tools ativas, separadas por vírgula. Se vazio/ausente, usa enabled_tools do config.yaml
# ENABLED_TOOLS=calculo,clima,feriados,sistema,tempo

# Pasta das tools personalizadas (padrão: ./custom_tools; no container /app/custom_tools)
# Toda .py ali (sem _ no início) sobe automaticamente.
# CUSTOM_TOOLS_DIR=

# Opcional: carregar segredos via Infisical (`infisical run`). Sem os IDs, vale o .infisical.json
# USE_INFISICAL=false
# INFISICAL_ENV=prod
# INFISICAL_PROJECT_ID=
# INFISICAL_PATH=/
# Instância própria (vira --domain no login e no run):
# INFISICAL_API_URL=https://infisical.exemplo.com
# Machine identity (Universal Auth): o pipe faz login a cada boot e usa um token de sessão
# INFISICAL_UNIVERSAL_AUTH_CLIENT_ID=
# INFISICAL_UNIVERSAL_AUTH_CLIENT_SECRET=
# Alternativa legada: token fixo (vence e derruba o boot; prefira Universal Auth)
# INFISICAL_TOKEN=
